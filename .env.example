# Скопировать в .env.local и заполнить реальными значениями.
# .env.local никогда не коммитится (см. .gitignore).

# ---------- Supabase ----------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — секретный, используется только на сервере (webhook Robokassa).
# Никогда не добавлять префикс NEXT_PUBLIC_ и не светить в клиентском коде.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Сайт ----------
NEXT_PUBLIC_SITE_URL=https://tatanka.kz

# ---------- Robokassa ----------
# Личный кабинет robokassa.kz → Настройки магазина
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# true — тестовый режим (IsTest=1 в ссылке оплаты), false — боевые платежи
ROBOKASSA_TEST_MODE=true
